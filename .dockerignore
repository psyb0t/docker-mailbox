# Build context = whatever Docker COPYs from. The prod Dockerfile only needs:
#   pyproject.toml, uv.lock*, README.md, src/
# Everything else is dev-only noise. Excluding it speeds builds and shrinks
# the cache-invalidation surface.

# VCS / CI / repo metadata
.git
.gitignore
.gitattributes
.github

# Docker / compose (image doesn't build itself)
.dockerignore
Dockerfile.dev
docker-compose*.yml
docker-compose*.yaml

# Build tooling not used inside the image
Makefile
scripts/

# Python caches / virtualenvs / build artifacts
.venv
venv
env
__pycache__
*.py[cod]
*.egg-info
build
dist
.eggs

# Test / coverage / lint caches
.pytest_cache
.mypy_cache
.ruff_cache
.coverage
.coverage.*
htmlcov
coverage.xml
.tox
.nox

# Tests + dev docs — image doesn't ship tests
tests
docs
ANUSTIMES.md
ANUSTIMES_*.md
*.md
!README.md

# Editor / OS junk
.idea
.vscode
.DS_Store
*.swp
*.swo

# Local scratch / research
.research_files
*.local
*.bak
*.orig
*.rej
*.log
.scratch
.tmp

# Local tooling that must never enter an image
git-update.sh
pyrightconfig.json
.flake8
.python-version

# Example config — runtime config is mounted at /etc/mailboxd/config.yaml
config.example.yaml

# Secrets / runtime config — must NEVER end up in the image
.env
.env.*
.envrc
config.yaml
config.yml
*.pem
*.key
*.p12
*.pfx
id_rsa*
id_ed25519*
