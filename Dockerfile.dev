# Sandboxed dev container — every make target runs inside this so the host
# stays clean. Has uv + docker CLI (for `make test-docker` via socket-mount).
# The full dev env is baked into /opt/venv at build time, so there's no
# .venv on the host bind-mount.
FROM python:3.12-slim-bookworm@sha256:d193c6f51a7dbd10395d6328de3a7edb0516fb0608ca138036576f574c3e07d2

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    UV_LINK_MODE=copy \
    UV_COMPILE_BYTECODE=1 \
    UV_PROJECT_ENVIRONMENT=/opt/venv \
    PATH=/opt/venv/bin:$PATH \
    PYTHONPATH=/work/src \
    TZ=UTC

RUN apt-get update && apt-get install -y --no-install-recommends \
        build-essential \
        git \
        curl \
        ca-certificates \
        gnupg \
        jq \
    && install -m 0755 -d /etc/apt/keyrings \
    && curl -fsSL https://download.docker.com/linux/debian/gpg \
        | gpg --dearmor -o /etc/apt/keyrings/docker.gpg \
    && chmod a+r /etc/apt/keyrings/docker.gpg \
    && echo "deb [arch=$(dpkg --print-architecture) signed-by=/etc/apt/keyrings/docker.gpg] \
        https://download.docker.com/linux/debian bookworm stable" \
        > /etc/apt/sources.list.d/docker.list \
    && apt-get update \
    && apt-get install -y --no-install-recommends docker-ce-cli \
    && rm -rf /var/lib/apt/lists/*

COPY --from=ghcr.io/astral-sh/uv:0.5.11@sha256:0ac957607303916420297a4c9c213bb33fbd3c888f9cd7f4f7273596ebf42b85 /uv /usr/local/bin/uv

WORKDIR /work

# Bake deps into /opt/venv. Copy only pyproject + uv.lock so the layer cache
# invalidates only when those change. --no-install-project skips installing
# mailboxd itself — the source lives on the bind-mount and is importable via
# PYTHONPATH=/work/src.
COPY pyproject.toml uv.lock* README.md ./
RUN --mount=type=cache,target=/root/.cache/uv \
    uv sync --frozen --group dev --no-install-project \
    || uv sync --group dev --no-install-project

# Security scanners for `make sec`, isolated in their own venv so semgrep's
# bundled mcp pin (mcp>=1.29) cannot collide with the project's mcp==1.9.0 in
# /opt/venv. Reached only through the /usr/local/bin symlinks.
RUN python3 -m venv /opt/sectools \
    && /opt/sectools/bin/pip install --no-cache-dir \
        semgrep==1.172.0 \
        bandit==1.9.4 \
        bandit-sarif-formatter==1.1.1 \
        pip-audit==2.10.1 \
    && ln -s /opt/sectools/bin/semgrep /opt/sectools/bin/bandit \
        /opt/sectools/bin/pip-audit /usr/local/bin/
